<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The SMAppService attempt for a LoginWindow agent (P3). Apple DTS expects it to fail (macos.md 5b). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.swapdesk.probe.loginwindow</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/SwapdeskProbeAgent.app/Contents/MacOS/swapdesk-probe</string>
	<key>ProgramArguments</key>
	<array>
		<string>swapdesk-probe</string>
		<string>agent-run</string>
		<string>--name</string>
		<string>loginwindow</string>
		<string>--every</string>
		<string>15</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>LoginWindow</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
