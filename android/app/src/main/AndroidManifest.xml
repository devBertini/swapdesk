<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android gives no socket of any kind without it. Swapdesk stays on the local network by its own guard
         (docs/ANDROID.md 4), not by this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Which networks the phone has and what they are (Wi-Fi, a VPN, mobile data): the guard's facts. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- From Android 17 the local network is a permission the person grants (asked at the first list of the
         network, docs/ANDROID.md 4); without it nothing Swapdesk sends leaves the phone. Older versions ignore it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="Swapdesk">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
