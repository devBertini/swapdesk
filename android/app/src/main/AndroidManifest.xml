<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android gives no socket of any kind without it. Swapdesk reaches computers on any network (D93); who may
         enter is decided by pairing and the pinned keys, not by this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The multicast lock (MainActivity): without it the phone's Wi-Fi drops the mDNS answers of the computers. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Which networks the phone has and what they are (Wi-Fi, a VPN, mobile data): the guard's facts. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- From Android 17 the local network is a permission the person grants (asked at the first list of the
         network, docs/ANDROID.md 4); without it nothing Swapdesk sends leaves the phone. Older versions ignore it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- allowBackup: no cloud backup. dataExtractionRules: no transfer to another phone either, which Android 12
         and later still make without it (res/xml/data_extraction_rules.xml says why). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:label="Swapdesk"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- configChanges: the screens are painted for the view's size and appearance at every frame, so the phone
             turned sideways, a split screen or the dark theme change nothing of the activity: it is not made again,
             and what is on the screen (a pairing code) stays.
             adjustResize: when the keyboard shows, the screen keeps clear of it (it takes the keyboard as an inset)
             and scrolls the field being typed in into sight. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
